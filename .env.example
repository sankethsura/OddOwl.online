# true switches on the CMS and ordering. Without it the site shows the built-in catalogue and uses no database.
DATABASE_ENABLED=true
# MongoDB Atlas connection string. The shop always uses a database named "oddowl" on this cluster.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay: from https://dashboard.razorpay.com/app/keys (use rzp_test_ keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
